{
  "id": "boardui",
  "name": "boardui PCB metadata",
  "description": "EXT_structural_metadata schema embedded in every boardui asset. See spec/README.md §8.2. References between tables are UINT32 row indices; 4294967295 means none.",
  "version": "0.9",
  "enums": {
    "FeatureKind": {
      "valueType": "UINT8",
      "values": [
        { "name": "PAD", "value": 0 },
        { "name": "VIA", "value": 1 },
        { "name": "TRACE", "value": 2 },
        { "name": "FILL", "value": 3 },
        { "name": "BARREL", "value": 4 },
        { "name": "MARKING", "value": 5 },
        { "name": "SHEET", "value": 6 },
        { "name": "FIDUCIAL", "value": 7 },
        { "name": "OTHER", "value": 255 }
      ]
    },
    "Side": {
      "valueType": "UINT8",
      "values": [
        { "name": "TOP", "value": 0 },
        { "name": "BOTTOM", "value": 1 },
        { "name": "INTERNAL", "value": 2 }
      ]
    },
    "Mount": {
      "valueType": "UINT8",
      "values": [
        { "name": "SMT", "value": 0 },
        { "name": "THMT", "value": 1 },
        { "name": "OTHER", "value": 255 }
      ]
    },
    "Fiducial": {
      "valueType": "UINT8",
      "values": [
        { "name": "GLOBAL", "value": 0 },
        { "name": "LOCAL", "value": 1 },
        { "name": "BAD_BOARD", "value": 2 },
        { "name": "GOOD_PANEL", "value": 3 },
        { "name": "NONE", "value": 255 }
      ]
    },
    "Populate": {
      "valueType": "UINT8",
      "values": [
        { "name": "YES", "value": 0 },
        { "name": "NO", "value": 1 },
        { "name": "UNKNOWN", "value": 255 }
      ]
    }
  },
  "classes": {
    "net": {
      "properties": {
        "id": { "type": "STRING", "required": true },
        "name": { "type": "STRING", "required": true },
        "instance": { "type": "SCALAR", "componentType": "UINT32", "noData": 4294967295 }
      }
    },
    "component": {
      "properties": {
        "id": { "type": "STRING", "required": true },
        "refDes": { "type": "STRING", "required": true },
        "part": { "type": "STRING", "noData": "" },
        "package": { "type": "STRING", "noData": "" },
        "side": { "type": "ENUM", "enumType": "Side", "required": true },
        "mount": { "type": "ENUM", "enumType": "Mount", "noData": "OTHER" },
        "node": { "type": "SCALAR", "componentType": "UINT32", "required": true },
        "instance": { "type": "SCALAR", "componentType": "UINT32", "noData": 4294967295 },
        "populate": {
          "description": "Whether the BOM places the part (IPC-2581 RefDes@populate). UNKNOWN without a BOM entry. Omitted from tables without BOM entries.",
          "type": "ENUM",
          "enumType": "Populate",
          "noData": "UNKNOWN"
        }
      }
    },
    "attribute": {
      "description": "An attribute of a component, from its BOM item or (since 0.9) its NonstandardAttributes (spec §8.2): rows in component order, names unique per component, values not empty.",
      "properties": {
        "component": { "type": "SCALAR", "componentType": "UINT32", "required": true },
        "name": { "type": "STRING", "required": true },
        "value": { "type": "STRING", "required": true }
      }
    },
    "pin": {
      "properties": {
        "id": { "type": "STRING", "required": true },
        "number": { "type": "STRING", "required": true },
        "name": { "type": "STRING", "noData": "" },
        "component": { "type": "SCALAR", "componentType": "UINT32", "required": true },
        "net": { "type": "SCALAR", "componentType": "UINT32", "noData": 4294967295 }
      }
    },
    "feature": {
      "properties": {
        "kind": { "type": "ENUM", "enumType": "FeatureKind", "required": true },
        "source": {
          "description": "0-based document-order index of the source feature within its layer in its step; the feature ID is feat/<layer name>/<source>, or feat/<instance>/<layer name>/<source> in an instance.",
          "type": "SCALAR",
          "componentType": "UINT32",
          "required": true
        },
        "net": { "type": "SCALAR", "componentType": "UINT32", "noData": 4294967295 },
        "pin": { "type": "SCALAR", "componentType": "UINT32", "noData": 4294967295 },
        "component": { "type": "SCALAR", "componentType": "UINT32", "noData": 4294967295 },
        "fiducial": {
          "description": "The IPC-2581 fiducial element of a FIDUCIAL feature. Omitted from tables without fiducials.",
          "type": "ENUM",
          "enumType": "Fiducial",
          "noData": "NONE"
        },
        "text": {
          "description": "The textString of the Text elements the feature draws, in document order, joined by line feeds; without them, the value of its Set's NonstandardAttribute named TEXT (since 0.9). Omitted from tables without text.",
          "type": "STRING",
          "noData": ""
        },
        "instance": { "type": "SCALAR", "componentType": "UINT32", "noData": 4294967295 }
      }
    },
    "instance": {
      "description": "A placed copy of a step in a panel (spec §6.14). It maps a point (u, v) of its step to the board point (x, y) + R(angle) · F · (u, v) in IPC-2581 axes, where F mirrors u when side is BOTTOM.",
      "properties": {
        "id": { "type": "STRING", "required": true },
        "step": { "type": "STRING", "required": true },
        "parent": { "type": "SCALAR", "componentType": "UINT32", "noData": 4294967295 },
        "x": { "type": "SCALAR", "componentType": "FLOAT64", "required": true },
        "y": { "type": "SCALAR", "componentType": "FLOAT64", "required": true },
        "angle": { "type": "SCALAR", "componentType": "FLOAT64", "required": true },
        "side": { "type": "ENUM", "enumType": "Side", "required": true }
      }
    }
  }
}
