{
  "name": "@boardui/converter",
  "version": "0.1.0",
  "private": true,
  "description": "Converts IPC-2581 to boardui glTF in the browser (WebAssembly in a Web Worker).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midub/boardui.git",
    "directory": "packages/converter"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./wasm": {
      "types": "./wasm/boardui_wasm.d.ts",
      "default": "./wasm/boardui_wasm.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "node scripts/build-wasm.mjs && tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
