{
  "name": "@boardui/viewer",
  "version": "0.1.0",
  "description": "<board-viewer>: a web component that shows boardui glTF boards in 3D.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midub/boardui.git",
    "directory": "packages/viewer"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.dev.json && vite build",
    "dev": "vite",
    "test": "vitest run"
  },
  "peerDependencies": {
    "three": "catalog:"
  },
  "dependencies": {
    "three-mesh-bvh": "catalog:"
  },
  "devDependencies": {
    "@types/three": "catalog:",
    "ajv": "catalog:",
    "gltf-validator": "catalog:",
    "three": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
