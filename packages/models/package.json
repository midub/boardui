{
  "name": "@boardui/models",
  "version": "1.1.1",
  "private": true,
  "description": "Runtime component models for <board-viewer>: STEP and OBJ loaders, KiCad's libraries, model mapping files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midub/boardui.git",
